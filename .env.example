# ==============================================================================
# RED TAG AREA MONITORING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Operational Mode: 'test' (Development/Test Mode) or 'hardware' (Production Hardware Mode)
APP_MODE=test

# Server Port
PORT=3001

# RFID Reader Configuration (USB / Serial COM Port)
# On Windows: COM3, COM4, etc. On Linux: /dev/ttyUSB0
RFID_PORT=COM3
RFID_BAUD_RATE=9600

# RFID Authorization Window (Milliseconds)
# When an authorized badge is scanned, an authorization window of this duration is opened.
RFID_AUTHORIZATION_WINDOW_MS=60000

# CCTV Camera Source & Configuration
# Options: 'webcam' (USB Webcam e.g. Logitech C920), 'rtsp', or 'simulator'
CAMERA_MODE=webcam
RTSP_URL=rtsp://admin:password@192.168.1.108:554/Streaming/Channels/102

# Computer Vision & Placement Persistence Thresholds
# Minimum duration an object must remain stationary inside Red Tag ROI to confirm placement
MIN_OBJECT_PERSISTENCE_MS=800
PERSISTENCE_FRAMES=4
CONFIDENCE_THRESHOLD=0.25

# Evidence Capture & Privacy Crop Padding
# Padding in pixels added around the object bounding box before cropping.
EVIDENCE_PADDING_PX=20
EVIDENCE_DIR=./uploads/evidence

# Alert System & Reporting
ENABLE_AUDIO_SIREN=true
TEAMS_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_RECIPIENT=safety-admin@factory.com
